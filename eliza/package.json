{
  "name": "eliza",
  "description": "Project starter for elizaOS",
  "version": "1.0.0-beta.35",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
