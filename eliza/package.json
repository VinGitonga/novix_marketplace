      }
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@elizaos/cli": "1.0.0-beta.37",
    "@elizaos/core": "1.0.0-beta.37",
    "@elizaos/plugin-anthropic": "1.0.0-beta.37",
    "@elizaos/plugin-bootstrap": "1.0.0-beta.37",
    "@elizaos/plugin-hedera": "file:../eliza-plugin-hedera",
    "@elizaos/plugin-local-ai": "1.0.0-beta.37",
    "@elizaos/plugin-openai": "1.0.0-beta.37",
    "@elizaos/plugin-sql": "1.0.0-beta.37",
    "axios": "^1.9.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "plugin-hedera": "git+https://github.com/hedera-dev/eliza-plugin-hedera",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@vitest/coverage-v8": "2.1.5",
    "prettier": "3.5.3",
    "tsup": "8.4.0",
    "vitest": "2.1.5"
  },
  "scripts": {
    "start": "elizaos start",
    "dev": "elizaos dev",
